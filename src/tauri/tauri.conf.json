{
	"$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "40",
	"version": "../../package.json",
	"identifier": "com.dogs.forty",
	"build": {
		"frontendDist": "../../dist/web",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "40",
				"width": 460,
				"height": 860,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"publisher": "DOGS",
		"copyright": "© DOGS",
		"shortDescription": "40",
		"longDescription": "Track any habit, share what you choose. Everything public is wiped every 40 days.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	}
}
