{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "40",
  "version": "0.1.0",
  "identifier": "com.dogs.forty",
  "build": {
    "beforeDevCommand": "npm run devVite -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "40",
        "width": 460,
        "height": 860,
        "minWidth": 320,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DOGS",
    "copyright": "© DOGS",
    "shortDescription": "40",
    "longDescription": "Track any habit, share what you choose. Everything public is wiped every 40 days.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
