// Cloudflare Worker "40": serves the static web build AND the /api backend. Created by DOGS.
// Top level is PRODUCTION. It ships only from a push to master, through Workers Builds (scripts/deploy.js).
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "40",
	"main": "index.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "../dist/web",
		"not_found_handling": "single-page-application",
		// Only /api costs Worker requests; the app itself is served straight from the asset store.
		"run_worker_first": ["/api/*"]
	},
	"observability": { "enabled": true },
	// Production answers on the custom domain only. Worker Previews still get workers.dev URLs.
	"routes": [{ "pattern": "40.dogs.red", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "forty",
			"database_id": "7733e047-87b8-4563-bc6f-3b3fb05e077b",
			"migrations_dir": "migrations"
		}
	],
	// Hourly check: when the 40-day cycle has ended, every post and comment is deleted (worker/cycle.js).
	"triggers": { "crons": ["0 * * * *"] },
	"vars": {
		// Extra allowed origins (comma-separated). The Worker's own origin and the native apps are built in.
		"ALLOWED_ORIGINS": "",
		// Free-tier guard (worker/limits.js). "off" removes every limit: only do that on a paid plan.
		"FREE_TIER_GUARD": "on",
		// The fraction of the account's free daily allowance this Worker may use (other Workers share it).
		"FREE_TIER_SHARE": "0.33"
	},
	// Worker Previews: every pull request branch gets its own Preview (`wrangler preview`, run by Workers Builds
	// through scripts/preview.js). Previews never inherit the production bindings above: they run on the staging
	// database, which only ever holds dummy data (`pnpm seed:preview`).
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "forty-staging",
				"database_id": "bb04ce85-a410-4c96-b7f0-c7fc4d95b895",
				"migrations_dir": "migrations"
			}
		],
		"vars": { "ALLOWED_ORIGINS": "", "FREE_TIER_GUARD": "on", "FREE_TIER_SHARE": "0.05" }
	},
	"env": {
		// The handle for staging from the command line (`--env preview`): migrations and the seeder use it.
		// It is not deployed as a Worker of its own.
		"preview": {
			"name": "40-preview",
			"routes": [],
			"workers_dev": true,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "forty-staging",
					"database_id": "bb04ce85-a410-4c96-b7f0-c7fc4d95b895",
					"migrations_dir": "migrations"
				}
			],
			"triggers": { "crons": [] },
			"vars": { "ALLOWED_ORIGINS": "", "FREE_TIER_GUARD": "on", "FREE_TIER_SHARE": "0.05" }
		}
	}
	// Secrets (never in this file). Production: BETTER_AUTH_SECRET (pnpm wrangler secret put BETTER_AUTH_SECRET).
	// Previews: BETTER_AUTH_SECRET and PREVIEW_PASSWORD (pnpm wrangler preview base-config secret put <NAME>).
	// Local: the root .env.
}
