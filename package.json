{
  "name": "forty",
  "description": "40: track any habit, share what you choose, and everything public is wiped every 40 days. Made by DOGS.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "npx --yes wrangler dev --port 8788",
    "devVite": "vite",
    "build": "vite build",
    "test": "vitest",
    "cloudflare:db:migrate:local": "npx --yes wrangler d1 migrations apply forty --local",
    "seed:preview": "node scripts/seed-preview.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.70.0",
    "@tauri-apps/api": "^2.12.4",
    "better-auth": "^1.7.18"
  }
}
