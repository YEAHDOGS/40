# Copy to .env (which is gitignored) and fill in. Never commit real values.
#
#   cp .env.example .env

# SQLite file for Prisma (dev). Postgres recommended for production.
DATABASE_URL="file:./dev.db"

# Signs auth JWTs. REQUIRED in production — the server refuses to be quiet
# about it, but generate a real one:  openssl rand -base64 48
JWT_SECRET="change-me-in-production"

# Redis session cache. Optional — falls back to in-memory (dev only).
REDIS_URL="redis://localhost:6379"

# Pin the 40-day wipe cadence to a fixed grid (ISO date). Optional — defaults
# to first server start. See src/server/wipe.js.
# FORTY_WIPE_ANCHOR="2026-01-01T00:00:00.000Z"

# Who may call the triggerWipe mutation (purges ALL platform content).
# Comma-separated user IDs and/or usernames. DENY-BY-DEFAULT: with neither
# set, no one can trigger a manual wipe. See src/server/resolvers.js.
# FORTY_ADMIN_IDS="<user-id-1>,<user-id-2>"
# FORTY_ADMIN_USERNAMES="brando"

# Behind a reverse proxy you control that sanitizes X-Forwarded-For?
# Set TRUST_PROXY=1 so rate limits key on the real client IP.
# DEFAULT (unset): proxy headers are IGNORED — they are client-forgeable and
# trusting them lets an attacker mint a fresh per-IP rate-limit budget per
# request. See src/server/client-ip.js.
# TRUST_PROXY="1"
