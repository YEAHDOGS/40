# Copy to .env. One file for every local setting; .env is gitignored.
# CI uses GitHub repo variables/secrets with the same names instead (see docs/BUILDING.md).

# ===== App (public: these end up inside the app) ==============================================
# Production API URL used by the packaged desktop/mobile apps (the web app uses its own origin).
PUBLIC_API_URL=https://40.dogs.red

# ===== Worker secrets for `pnpm dev:api` =====================================================
# Production: pnpm wrangler secret put <NAME>
# Any long random string, e.g.: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# ===== Previews: dummy data only ==============================================================
# The demo account password, used by `pnpm seed:preview`. Must match the Previews secret:
# pnpm wrangler preview base-config secret put PREVIEW_PASSWORD
DEMO_PASSWORD=

# ===== Signing for local builds (pnpm build:desktop / build:android / build:ios) ==============
# Anything left empty => unsigned build. Full guide: docs/BUILDING.md

# Apple: App Store Connect API key (notarization + iOS automatic signing)
APPLE_API_ISSUER=
APPLE_API_KEY=
# e.g. /Users/you/keys/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_PATH=

# Apple: team (iOS)
APPLE_DEVELOPMENT_TEAM=

# macOS desktop: "Developer ID Application" certificate.
# If it's in your keychain, the identity alone is enough. Or give a base64 .p12 (what CI uses).
APPLE_SIGNING_IDENTITY=
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=

# iOS manual signing alternative (instead of automatic signing)
IOS_CERTIFICATE=
IOS_CERTIFICATE_PASSWORD=
IOS_MOBILE_PROVISION=

# Android upload key
# e.g. /Users/you/keys/upload.jks
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=

# Android SDK (needed for any Android build)
ANDROID_HOME=
NDK_HOME=
